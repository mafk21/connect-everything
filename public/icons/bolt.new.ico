script><script>(function setMinViewport() {
  const MIN_WIDTH = 360;

  function update() {
    /**
     * Never let the layout drop below the min width: on narrower screens the
     * browser scales the page down to fit instead of reflowing or scrolling.
     */
    const content = 'width=' + Math.max(window.screen.width, MIN_WIDTH);

    // react owns the node after hydration and may replace it, so look it up on every update
    document.querySelectorAll('meta[name="viewport"]').forEach((meta) => {
      if (meta.getAttribute('content') !== content) {
        meta.setAttribute('content', content);
      }
    });
  }

  update();
  window.__syncMinViewport = update;
  window.addEventListener('resize', update);
  window.addEventListener('orientationchange', update);
})();
</script><script>(function detectTheme() {
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  globalThis.prefersDark = prefersDark;

  const themeOption = document.documentElement.getAttribute('data-theme-option');

  if (themeOption === 'system') {
    document.documentElement.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
  }
})();
