---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import SearchField from '../components/SearchField.astro';
import ResourceCard from '../components/ResourceCard.astro';
import Brand from '../components/Brand.astro';
import MobileFilters from '../components/MobileFilters.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import IconSprite from '../components/IconSprite.astro';
import type { Resource } from '../data/resources';
import { categoryCounts, tagCounts, type CountedOption } from '../lib/derive';
import { recentResources } from '../lib/recent';
import { PAGE_SIZE } from '../lib/pagination';

interface Props {
  heading: string;
  resources: Resource[];
  allResources: Resource[];
  currentPath: string;
  metaTitle?: string;
  metaDescription?: string;
  intro?: string;
  /** index = the interactive library; other pages link filters to / */
  mode?: 'live' | 'links';
  structuredData?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  heading,
  resources,
  allResources,
  currentPath,
  metaTitle,
  metaDescription,
  intro,
  mode = 'links',
  structuredData,
  noindex,
} = Astro.props;

const REPO_URL = 'https://github.com/mafk21/connect-everything';

// Which browsable page we are on, so the sidebar can mark it.
const activeCategory = currentPath.startsWith('/category/')
  ? currentPath.split('/')[2]
  : undefined;
const activeTag = currentPath.startsWith('/tag/') ? currentPath.split('/')[2] : undefined;
const categories: CountedOption[] = categoryCounts(allResources);
const tags: CountedOption[] = tagCounts(allResources);
const featuredCount = allResources.filter((resource) => resource.featured).length;
const recentCount = recentResources(allResources).length;
const live = mode === 'live';
---

<BaseLayout title={metaTitle} description={metaDescription} structuredData={structuredData} noindex={noindex}>
  <div class="mx-auto w-full max-w-[var(--spacing-page)] px-3 py-3 sm:px-4 sm:py-4 lg:px-6 lg:py-6">
    <div
      class="grid min-h-[calc(100dvh-24px)] grid-cols-1 overflow-hidden rounded-panel border border-line bg-surface shadow-panel sm:min-h-[calc(100dvh-32px)] lg:min-h-[calc(100dvh-48px)] lg:grid-cols-[var(--spacing-sidebar)_1fr]"
      data-library={live ? 'live' : 'static'}
    >
      <IconSprite />

      <div class="hidden lg:block">
        <Sidebar
          categories={categories}
          tags={tags}
          total={allResources.length}
          recentCount={recentCount}
          featuredCount={featuredCount}
          currentPath={currentPath}
          mode={mode}
          activeCategory={activeCategory}
          activeTag={activeTag}
        />
      </div>

      <div class="flex min-w-0 flex-col bg-mint-100">
        <header class="flex flex-wrap items-center gap-2 border-b border-line bg-surface px-4 py-3 sm:gap-3 sm:px-5">
          <div class="lg:hidden">
            <Brand />
          </div>

          <div class="order-4 w-full sm:order-none sm:w-auto sm:flex-1">
            <SearchField live={live} />
          </div>

          <div class="ml-auto flex flex-wrap items-center justify-end gap-2">
            <MobileFilters
              categories={categories}
              tags={tags}
              mode={mode}
              activeCategory={activeCategory}
              activeTag={activeTag}
            />

            <ThemeToggle />

            <a
              href="/rss.xml"
              class="rounded transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
            >
              RSS
            </a>
            <a
              href="/suggest"
              class="inline-flex h-9 shrink-0 items-center gap-1.5 rounded-chip bg-teal-900 px-3.5 text-meta font-medium text-white transition-colors hover:bg-teal-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
            >
              <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M12 5.5v13M5.5 12h13" />
              </svg>
              Suggest a resource
            </a>
          </div>
        </header>

        <main id="main" class="flex-1 px-4 py-5 sm:px-5">
          <!-- Small screens never see the sidebar, so they get the categories inline. -->
          <div
            class="-mx-4 mb-4 flex gap-1.5 overflow-x-auto px-4 pb-1 sm:-mx-5 sm:px-5 lg:hidden"
            data-category-scroller
            aria-label="Categories"
          >
            {
              live ? (
                <>
                  <button
                    type="button"
                    data-clear-category
                    class="chip chip--filter shrink-0"
                    aria-pressed="true"
                  >
                    All
                  </button>
                  {categories.map((category) => (
                    <button
                      type="button"
                      data-filter-category={category.id}
                      data-label={category.label}
                      aria-pressed="false"
                      class="chip chip--filter shrink-0"
                    >
                      <span>{category.label}</span>
                      <span class="chip__count" data-count-category={category.id}>
                        {category.count}
                      </span>
                    </button>
                  ))}
                </>
              ) : (
                /* No engine on these pages: the row is navigation, not filters. */
                <>
                  <a href="/" class="chip chip--filter shrink-0">
                    All
                  </a>
                  {categories.map((category) => (
                    <a
                      href={`/category/${category.id}`}
                      aria-current={activeCategory === category.id ? 'page' : undefined}
                      class="chip chip--filter shrink-0"
                    >
                      <span>{category.label}</span>
                      <span class="chip__count">{category.count}</span>
                    </a>
                  ))}
                </>
              )
            }
          </div>

          <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
            <div class="min-w-0">
              <h1 class="text-page-title font-bold text-ink" data-heading>{heading}</h1>
              <p class="mt-1 text-meta text-ink-muted" data-intro>
                {
                  intro ? (
                    intro
                  ) : (
                    <>
                      <span aria-live="polite">
                        <span data-result-count>{resources.length}</span>
                        <span data-result-noun>
                          {resources.length === 1 ? 'resource' : 'resources'}
                        </span>
                      </span>{' '}
                      <span class="text-ink-muted/80">· click any card to open it</span>
                    </>
                  )
                }
              </p>
            </div>

            <div class="flex items-center gap-2">
              <label for="sort-library" class="sr-only">Sort resources</label>
              <div class="relative">
                <select
                  id="sort-library"
                  data-sort
                  class="h-9 appearance-none rounded-chip border border-line bg-surface pl-3 pr-8 text-meta text-ink-soft transition-colors hover:border-line-strong focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
                  disabled={!live}
                >
                  <option value="newest">Newest first</option>
                  <option value="az">A–Z</option>
                </select>
                <svg
                  class="pointer-events-none absolute right-2.5 top-1/2 size-3.5 -translate-y-1/2 text-ink-muted"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m6 9.5 6 6 6-6" />
                </svg>
              </div>
            </div>
          </div>

          <div
            data-active-filters
            hidden
            class="mb-4 flex flex-wrap items-center gap-x-2 gap-y-1.5 rounded-card border border-line bg-surface/70 px-3 py-2"
          >
            <span class="text-meta text-ink-muted">Showing</span>
            <ul class="flex flex-wrap items-center gap-1.5" data-active-list></ul>
            <button
              type="button"
              data-clear-filters
              class="ml-auto inline-flex items-center gap-1 rounded-chip px-2 py-1 text-meta font-medium text-accent transition-colors hover:bg-mint-100"
            >
              Clear all
            </button>
          </div>

          <p
            data-fuzzy-note
            hidden
            class="mb-4 rounded-card border border-dashed border-line-strong bg-surface/70 px-3 py-2 text-meta text-ink-muted"
          >
          </p>

          <ul
            class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3"
            data-grid
            data-page-size={PAGE_SIZE}
          >
            {
              resources.map((resource, index) => (
                <li class="h-full" data-card hidden={index >= PAGE_SIZE}>
                  <ResourceCard resource={resource} mode={mode} />
                </li>
              ))
            }
          </ul>

          <!--
            Pagination. Hidden cards are still in the DOM, so the engine can
            reveal them instantly; with JavaScript off the <noscript> rule
            below shows everything and nothing is lost.
          -->
          <div class="mt-6 flex flex-col items-center gap-2" data-load-more-wrap hidden>
            <button
              type="button"
              data-load-more
              class="inline-flex h-10 items-center gap-2 rounded-chip bg-teal-900 px-5 text-body font-medium text-white transition-colors hover:bg-teal-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
            >
              <span data-load-more-label>Show more</span>
              <svg
                viewBox="0 0 24 24"
                class="size-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m6 9.5 6 6 6-6" />
              </svg>
            </button>
            <p class="text-meta text-ink-muted">
              <span data-shown-count>{Math.min(resources.length, PAGE_SIZE)}</span> of
              <span data-shown-total>{resources.length}</span> shown
            </p>
          </div>

          <noscript>
            <style>{`[data-card][hidden] { display: block !important; }`}</style>
          </noscript>


          <div
            data-empty-state
            hidden
            class="mx-auto flex max-w-sm flex-col items-center rounded-card border border-dashed border-line-strong bg-surface/70 px-6 py-12 text-center"
          >
            <span class="grid size-11 place-items-center rounded-full bg-mint-100 text-accent">
              <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                <circle cx="11" cy="11" r="6.5" />
                <path d="m16 16 4 4" />
              </svg>
            </span>
            <h2 class="mt-4 text-nav font-semibold text-ink">Nothing matches yet</h2>
            <p class="mt-1.5 text-meta leading-relaxed text-ink-muted">
              No resource fits this combination of filters. Try a broader search, or clear
              everything and start again.
            </p>
            <button
              type="button"
              data-clear-filters
              class="mt-4 inline-flex h-9 items-center rounded-chip bg-teal-900 px-3.5 text-meta font-medium text-white transition-colors hover:bg-teal-700"
            >
              Clear filters
            </button>
          </div>
        </main>

        <!-- Crawlable category links: the live sidebar uses buttons, so without
             these the static /category and /tag pages would have no inbound links. -->
        <nav
          aria-label="Browse by category"
          class="flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-line px-4 py-3 text-meta text-ink-muted sm:px-5"
        >
          <span class="text-[11px] font-semibold uppercase tracking-[0.09em]">Categories</span>
          {
            categories.map((category) => (
              <a
                href={`/category/${category.id}`}
                class="rounded transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
              >
                {category.label}
              </a>
            ))
          }
        </nav>

        <footer
          class="flex flex-col gap-2 border-t border-line px-4 py-4 text-meta text-ink-muted sm:flex-row sm:items-center sm:justify-between sm:px-5"
        >
          <p data-footer-count>
            {resources.length} of {allResources.length} resources · curated by hand
          </p>
          <nav aria-label="Footer" class="flex flex-wrap items-center gap-x-4 gap-y-1">
            <a
              href="/featured"
              class="rounded transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
            >
              Start here
            </a>
            <a
              href="/rss.xml"
              class="rounded transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
            >
              RSS
            </a>
            <a
              href="/suggest"
              class="rounded transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
            >
              Suggest a resource
            </a>
            <a
              href={REPO_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-1 rounded transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
            >
              GitHub
              <svg
                viewBox="0 0 24 24"
                class="size-3 transition-transform group-hover:-translate-y-px group-hover:translate-x-px"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M8 16 16 8M9.5 8H16v6.5" />
              </svg>
            </a>
          </nav>
        </footer>
      </div>
    </div>
  </div>
</BaseLayout>

<!--
  Both scripts are emitted unconditionally and guard themselves: `library`
  only starts where a [data-library="live"] root exists, and `pagination`
  only runs where there is no engine. Wrapping a <script> in a conditional
  expression looks equivalent, but Astro's dev server does not emit it — which
  left the preview without any JavaScript while builds were fine.
-->
<script>
  import '../scripts/library';
  import '../scripts/pagination';
</script>
