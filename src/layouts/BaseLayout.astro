---
import '@fontsource-variable/inter';
import '../styles/global.css';
import DecorativeShapes from '../components/DecorativeShapes.astro';

interface Props {
  title?: string;
  description?: string;
  /** Extra schema.org objects for this page, rendered as JSON-LD. */
  structuredData?: Record<string, unknown>[];
  /** Arbitrary extra head content (e.g. robots directives). */
  noindex?: boolean;
}

const {
  title = 'Connect Everything — a curated toolbox of the useful internet',
  description = 'A hand-curated library of websites, tools, tutorials and references. Browse, search and click straight through. No account needed.',
  structuredData = [],
  noindex = false,
} = Astro.props;

const SITE = Astro.site ?? new URL('https://connecteverything.example');
const canonical = new URL(Astro.url.pathname, SITE);
const ogImage = new URL('/og-default.png', SITE);

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Connect Everything',
  url: SITE.href,
  description:
    'A public, hand-curated library of useful websites, tools, tutorials and references.',
  inLanguage: 'en',
};

const schema = [website, ...structuredData];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#e8f1f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101a19" media="(prefers-color-scheme: dark)" />
    <link rel="alternate" type="application/rss+xml" title="Recently added" href="/rss.xml" />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Connect Everything" />
    <meta property="og:locale" content="en" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Connect Everything — the internet's useful bits, picked one at a time." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </head>

  <body class="min-h-dvh antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-chip focus:bg-teal-900 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white"
    >
      Skip to content
    </a>

    <DecorativeShapes />

    <slot />
  </body>
</html>
