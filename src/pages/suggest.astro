---
import BaseLayout from '../layouts/BaseLayout.astro';
import Brand from '../components/Brand.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const REPO_URL = 'https://github.com/mafk21/connect-everything';
// Deep-links the issue form template, so a suggestion arrives with the three
// fields already laid out instead of a blank box.
const ISSUE_URL = `${REPO_URL}/issues/new?template=suggest-resource.yml`;
---

<BaseLayout
  title="Suggest a resource — Connect Everything"
  description="Know a site, tool or tutorial that belongs in the library? Suggest it on GitHub."
>
  <div class="mx-auto w-full max-w-[760px] px-4 py-10 sm:py-16">
    <div class="rounded-panel border border-line bg-surface p-7 shadow-panel sm:p-10">
      <div class="flex items-center justify-between gap-4">
        <Brand />
        <ThemeToggle />
      </div>

      <h1 class="mt-8 text-[28px] font-bold leading-tight text-ink">Suggest a resource</h1>
      <p class="mt-3 max-w-lg text-body text-ink-soft">
        The library is curated by hand, so not everything gets in — but everything gets read.
        Send a link and one line on why it earns a place. Suggestions are open on GitHub.
      </p>

      <div class="mt-7 rounded-card border border-line bg-mint-100/60 p-5">
        <h2 class="text-[11px] font-semibold uppercase tracking-[0.09em] text-ink-muted">
          What gets in
        </h2>
        <ul class="mt-3 space-y-2 text-body text-ink-soft">
          <li>· Still online, still maintained.</li>
          <li>· Free to use, or worth the price it asks.</li>
          <li>· Useful before you sign up, not after.</li>
          <li>· Something a person would genuinely return to.</li>
        </ul>
      </div>

      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href={ISSUE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-10 items-center gap-2 rounded-chip bg-teal-900 px-4 text-body font-medium text-white transition-colors hover:bg-teal-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
        >
          <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
            <path
              d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
            ></path>
          </svg>
          Suggest on GitHub
        </a>
        <a
          href="/"
          class="inline-flex h-10 items-center rounded-chip border border-line px-4 text-body font-medium text-ink-soft transition-colors hover:bg-mint-100 hover:text-accent"
        >
          Back to the library
        </a>
      </div>

      <a
        href={REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="group mt-8 flex items-start gap-3 border-t border-line pt-5 transition-colors"
      >
        <span
          class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-[9px] border border-line bg-surface text-accent transition-colors group-hover:border-line-strong group-hover:bg-mint-100"
        >
          <svg viewBox="0 0 24 24" class="size-[17px]" fill="currentColor" aria-hidden="true">
            <path
              d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
            ></path>
          </svg>
        </span>

        <span class="min-w-0">
          <span class="flex items-center gap-1.5 text-body font-semibold text-ink">
            Prefer to add it yourself? Open a pull request
            <svg
              viewBox="0 0 24 24"
              class="size-3.5 text-ink-muted transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M8 16 16 8M9.5 8H16v6.5" />
            </svg>
          </span>
          <span class="mt-1 block text-meta leading-relaxed text-ink-muted">
            The whole library lives in
            <code class="rounded bg-mint-100 px-1.5 py-0.5 text-[12px] text-accent">src/data/resources.ts</code>
            — edit that file and open a pull request, and it gets reviewed like any other entry.
            Nothing appears in the library until it is reviewed.
          </span>
          <span class="mt-1.5 block text-[12px] font-medium text-accent group-hover:underline">
            github.com/mafk21/connect-everything
          </span>
        </span>
      </a>
    </div>
  </div>
</BaseLayout>
