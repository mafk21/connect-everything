---
import LibraryLayout from '../layouts/LibraryLayout.astro';
import { RESOURCES } from '../data/resources';
import { validateResources } from '../lib/validate';

// Fails the build if any entry in resources.ts is malformed.
validateResources(RESOURCES);

const newestFirst = [...RESOURCES].sort((a, b) => b.dateAdded.localeCompare(a.dateAdded));

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'All resources',
  numberOfItems: RESOURCES.length,
  itemListElement: newestFirst.map((resource, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: resource.title,
    url: resource.url,
    description: resource.description,
  })),
};

---

<LibraryLayout
  heading="All resources"
  resources={newestFirst}
  allResources={RESOURCES}
  currentPath="/"
  mode="live"
  structuredData={[itemList]}
  metaTitle="Connect Everything — a curated toolbox of the useful internet"
  metaDescription="A hand-curated library of websites, tools, tutorials and references. Browse, search and click straight through. No account needed."
/>
