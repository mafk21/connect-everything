---
import LibraryLayout from '../layouts/LibraryLayout.astro';
import { RESOURCES } from '../data/resources';

const featured = RESOURCES.filter((resource) => resource.featured).sort((a, b) =>
  b.dateAdded.localeCompare(a.dateAdded)
);

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Start here',
  numberOfItems: featured.length,
  itemListElement: featured.map((resource, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: resource.title,
    url: resource.url,
    description: resource.description,
  })),
};
---

<LibraryLayout
  heading="Start here"
  resources={featured}
  allResources={RESOURCES}
  currentPath="/featured"
  structuredData={[itemList]}
  intro="Twelve picks to open first — useful on day one, and nobody paid to be here."
  metaTitle="Start here — Connect Everything"
  metaDescription="The twelve entries to open first in the Connect Everything library."
/>
