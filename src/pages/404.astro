---
import BaseLayout from '../layouts/BaseLayout.astro';
import Brand from '../components/Brand.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { RESOURCES } from '../data/resources';
import { CATEGORIES } from '../data/categories';
import { categoryCounts } from '../lib/derive';

/** A few genuinely useful starting points, rather than an apology. */
const suggestions = RESOURCES.filter((resource) => resource.featured).slice(0, 3);
const categories = categoryCounts(RESOURCES).filter((category) => category.count > 0);
---

<BaseLayout
  title="Page not found — Connect Everything"
  description="That page does not exist. Search the library or pick a category instead."
>
  <div class="mx-auto w-full max-w-[860px] px-4 py-8 sm:py-14">
    <div class="rounded-panel border border-line bg-white p-6 shadow-panel sm:p-10">
      <Brand />

      <p class="mt-9 text-[11px] font-semibold uppercase tracking-[0.09em] text-ink-muted">
        404
      </p>
      <h1 class="mt-2 text-[30px] font-bold leading-tight text-ink sm:text-[34px]">
        This link goes nowhere
      </h1>
      <p class="mt-3 max-w-md text-body leading-relaxed text-ink-soft">
        The page you were after does not exist — it may have been mistyped, or moved since you
        bookmarked it. The library itself is still right here.
      </p>

      <form action="/" method="get" role="search" class="mt-6 flex max-w-md gap-2">
        <label for="notfound-search" class="sr-only">Search the library</label>
        <div class="relative flex-1">
          <svg
            class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-ink-muted"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="6.5" />
            <path d="m16 16 4 4" />
          </svg>
          <input
            id="notfound-search"
            type="search"
            name="q"
            placeholder="Search resources, tools, tutorials…"
            autocomplete="off"
            class="h-10 w-full rounded-chip border border-line bg-white pl-9 pr-3 text-body text-ink placeholder:text-ink-muted focus:border-line-strong focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 [&::-webkit-search-cancel-button]:hidden"
          />
        </div>
        <button
          type="submit"
          class="inline-flex h-10 shrink-0 items-center rounded-chip bg-teal-900 px-4 text-body font-medium text-white transition-colors hover:bg-teal-700"
        >
          Search
        </button>
      </form>

      <nav aria-label="Categories" class="mt-5">
        <ul class="flex flex-wrap gap-2">
          {
            categories.map((category) => (
              <li>
                <a
                  href={`/?category=${category.id}`}
                  class="inline-flex items-center gap-1.5 rounded-chip border border-line bg-white px-2.5 py-1.5 text-meta text-ink-soft transition-colors hover:border-line-strong hover:bg-mint-100 hover:text-teal-900"
                >
                  {category.label}
                  <span class="tabular-nums text-ink-muted">{category.count}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <section class="mt-9 border-t border-line pt-6" aria-labelledby="notfound-picks">
        <h2 id="notfound-picks" class="text-[11px] font-semibold uppercase tracking-[0.09em] text-ink-muted">
          Or start with one of these
        </h2>
        <ul class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-3">
          {
            suggestions.map((resource) => (
              <li class="h-full">
                <ResourceCard resource={resource} mode="links" />
              </li>
            ))
          }
        </ul>
      </section>

      <div class="mt-8 flex flex-wrap gap-3 border-t border-line pt-6">
        <a
          href="/"
          class="inline-flex h-10 items-center gap-1.5 rounded-chip bg-teal-900 px-4 text-body font-medium text-white transition-colors hover:bg-teal-700"
        >
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10 5.5 3.5 12l6.5 6.5M3.5 12h17" />
          </svg>
          Back to the library
        </a>
        <a
          href="/suggest"
          class="inline-flex h-10 items-center rounded-chip border border-line px-4 text-body font-medium text-ink-soft transition-colors hover:bg-mint-100 hover:text-teal-900"
        >
          Suggest a resource
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
