---
/**
 * One icon sprite for the whole document.
 *
 * The card repeats four icons a few hundred times; inlining the path data each
 * time was adding roughly a megabyte to the page at 400 entries. Symbols are
 * defined once and referenced with <use>, which the browser caches.
 *
 * Usage: <svg class="size-4"><use href="#icon-star" /></svg>
 */
---

<svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
  <defs>
    <symbol id="icon-kebab" viewBox="0 0 24 24" fill="currentColor">
      <circle cx="12" cy="5.5" r="1.6" />
      <circle cx="12" cy="12" r="1.6" />
      <circle cx="12" cy="18.5" r="1.6" />
    </symbol>

    <symbol
      id="icon-category"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M4 7.5h16M4 12h10M4 16.5h7" />
    </symbol>

    <symbol
      id="icon-calendar"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect x="4" y="5.5" width="16" height="15" rx="2.5" />
      <path d="M4 10h16M8.5 3.5v4M15.5 3.5v4" />
    </symbol>

    <symbol id="icon-star" viewBox="0 0 24 24" fill="currentColor">
      <path d="m12 3.8 2.5 5.2 5.7.8-4.1 4 1 5.7-5.1-2.8-5.1 2.8 1-5.7-4.1-4 5.7-.8L12 3.8Z" />
    </symbol>

    <symbol
      id="icon-external"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M8 16 16 8M9.5 8H16v6.5" />
    </symbol>

    <symbol
      id="icon-search"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    >
      <circle cx="11" cy="11" r="6.5" />
      <path d="m16 16 4 4" />
    </symbol>
  </defs>
</svg>
