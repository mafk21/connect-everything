---
/**
 * One icon sprite for the whole document.
 *
 * The card repeats four icons a few hundred times; inlining the path data each
 * time was adding roughly a megabyte to the page at 400 entries. Symbols are
 * defined once and referenced with <use>, which the browser caches.
 *
 * Usage: <svg class="size-4"><use href="#icon-star" /></svg>
 */
---

<svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
  <defs>
    <symbol id="icon-design" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 4.5c-4.1 0-7.5 3-7.5 6.8 0 3.7 3.4 6.7 7.5 6.7h1.3a1.7 1.7 0 0 0 1.3-2.8c-.6-.8-.1-1.9.9-1.9h1.3c2 0 3.7-1.5 3.7-3.4 0-3-3.6-5.4-8.5-5.4Z"/><circle cx="8.4" cy="9.6" r="1"/><circle cx="12" cy="7.9" r="1"/><circle cx="15.6" cy="9.3" r="1"/>
    </symbol>

    <symbol id="icon-development" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="m8.5 8.5-4 3.5 4 3.5M15.5 8.5l4 3.5-4 3.5M13.4 5.5l-2.8 13"/>
    </symbol>

    <symbol id="icon-learning" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 6.2c2.6-1.1 5.3-1.1 8 .4 2.7-1.5 5.4-1.5 8-.4v11.4c-2.6-1.1-5.3-1.1-8 .4-2.7-1.5-5.4-1.5-8-.4V6.2Z"/><path d="M12 6.6v11"/>
    </symbol>

    <symbol id="icon-tools" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14.5 5.2a3.8 3.8 0 0 0 4.9 4.9l-8.3 8.3a2.5 2.5 0 0 1-3.5-3.5l8.3-8.3-1.4-1.4Z"/><path d="m6.6 6.6 2.1 2.1"/>
    </symbol>

    <symbol id="icon-productivity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <rect x="4.5" y="5" width="15" height="14.5" rx="2.2"/><path d="M4.5 9.5h15M9 4v3M15 4v3"/><path d="m9.3 14.2 1.9 1.9 3.6-3.6"/>
    </symbol>

    <symbol id="icon-media" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <rect x="4" y="5.5" width="12.5" height="10" rx="1.8"/><path d="m16.5 10 3.5-2v8l-3.5-2z"/><path d="M7.5 15.5v3M13 15.5v3"/>
    </symbol>

    <symbol id="icon-data-ai" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <rect x="7" y="7" width="10" height="10" rx="2.4"/><path d="M10 4v3M14 4v3M10 17v3M14 17v3M4 10h3M4 14h3M17 10h3M17 14h3"/>
    </symbol>

    <symbol id="icon-security" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 4.3 5.5 6.6v5c0 3.9 2.7 6.9 6.5 8.1 3.8-1.2 6.5-4.2 6.5-8.1v-5L12 4.3Z"/><path d="m9.4 11.9 1.9 1.9 3.5-3.6"/>
    </symbol>

    <symbol id="icon-reference" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 5.4c0-.6.5-1.1 1.1-1.1H18a1 1 0 0 1 1 1v13.4a1 1 0 0 1-1 1H6.1c-.6 0-1.1-.5-1.1-1.1V5.4Z"/><path d="M5 16.6h14M8.5 8h6.5M8.5 11h4.5"/>
    </symbol>

    <symbol
      id="icon-category"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M4 7.5h16M4 12h10M4 16.5h7" />
    </symbol>

    <symbol
      id="icon-calendar"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect x="4" y="5.5" width="16" height="15" rx="2.5" />
      <path d="M4 10h16M8.5 3.5v4M15.5 3.5v4" />
    </symbol>

    <symbol id="icon-star" viewBox="0 0 24 24" fill="currentColor">
      <path d="m12 3.8 2.5 5.2 5.7.8-4.1 4 1 5.7-5.1-2.8-5.1 2.8 1-5.7-4.1-4 5.7-.8L12 3.8Z" />
    </symbol>

    <symbol
      id="icon-external"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M8 16 16 8M9.5 8H16v6.5" />
    </symbol>

    <symbol
      id="icon-search"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    >
      <circle cx="11" cy="11" r="6.5" />
      <path d="m16 16 4 4" />
    </symbol>
  </defs>
</svg>
