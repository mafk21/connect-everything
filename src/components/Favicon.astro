---
import { monogramOf, remoteFaviconUrl } from '../lib/derive';
import favicons from '../data/favicons.json';

interface Props {
  title: string;
  url: string;
  size?: number;
}

const { title, url, size = 40 } = Astro.props;
const monogram = monogramOf(title);

const domain = (() => {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return '';
  }
})();

// Prefer the icon fetched at build time (see scripts/fetch-favicons.mjs). Until
// that has run for this domain, fall back to the remote lookup so the page
// does not lose its icons — after `npm run icons` the request never leaves.
const localIcon = (favicons as Record<string, string>)[domain];
const src = localIcon ?? remoteFaviconUrl(url);
---

<span
  class="relative grid shrink-0 place-items-center overflow-hidden rounded-[9px] border border-line bg-white"
  style={`width:${size}px;height:${size}px;background-color:${monogram.bg}`}
  aria-hidden="true"
>
  <span class="text-[15px] font-semibold" style={`color:${monogram.fg}`}>{monogram.letter}</span>
  <img
    src={src}
    alt=""
    width={size}
    height={size}
    loading="lazy"
    decoding="async"
    referrerpolicy="no-referrer"
    class="absolute inset-0 size-full bg-white object-contain p-[6px]"
    onerror="this.remove()"
  />
</span>
