---
import Favicon from './Favicon.astro';
import type { Resource } from '../data/resources';
import { categoryLabel, domainOf, formatDate, tagSlug } from '../lib/derive';

interface Props {
  resource: Resource;
  /** live = chips toggle filters in place; links = chips navigate to /?tag= */
  mode?: 'live' | 'links';
}

const { resource, mode = 'live' } = Astro.props;
const domain = domainOf(resource.url);
const added = formatDate(resource.dateAdded);
---

<article
  class="r-card"
  data-resource={resource.id}
  data-category={resource.category}
  data-tags={resource.tags.join('|')}
  data-featured={resource.featured ? 'true' : 'false'}
  data-date={resource.dateAdded}
>
  <!-- Whole-card link: one tab stop, opens the resource directly. -->
  <a
    href={resource.url}
    target="_blank"
    rel="noopener noreferrer"
    class="r-card__link"
  >
    <span class="sr-only">{resource.title} — {domain}, opens in a new tab</span>
  </a>

  <header class="r-card__head">
    <Favicon title={resource.title} url={resource.url} />
    <div class="r-card__titles">
      <h3 class="r-card__title" data-title-el>{resource.title}</h3>
      <p class="r-card__domain">{domain}</p>
    </div>

  </header>

  <p class="r-card__desc" data-description>{resource.description}</p>

  <ul class="r-card__tags">
    {
      resource.tags.map((tag) => (
        <li>
          {mode === 'live' ? (
            <button type="button" data-filter-tag={tag} class="chip">
              {tag}
            </button>
          ) : (
            <a href={`/?tag=${encodeURIComponent(tag)}`} class="chip">
              {tag}
            </a>
          )}
        </li>
      ))
    }
  </ul>

  <footer class="r-card__foot">
    <span class="r-card__meta">
      <svg class="size-3.5" aria-hidden="true"><use href="#icon-category" /></svg>
      {categoryLabel(resource.category)}
    </span>
    <span class="r-card__meta">
      <svg class="size-3.5" aria-hidden="true"><use href="#icon-calendar" /></svg>
      {added}
    </span>
    {
      resource.featured && (
        <span class="r-card__featured">
          <svg class="size-3.5" aria-hidden="true"><use href="#icon-star" /></svg>
          <span>Start here</span>
        </span>
      )
    }
  </footer>
</article>
