---
import type { CountedOption } from '../lib/derive';
import { TAG_GROUPS, TAG_GROUPS_VISIBLE } from '../data/tags';
import { tagSlug } from '../lib/derive';

interface Props {
  categories: CountedOption[];
  tags: CountedOption[];
  /** index page gets live buttons; other pages get links that resolve on / */
  mode?: 'live' | 'links';
  idPrefix?: string;
  /** Which row is the page we are on, for the non-JS (link) variant. */
  activeCategory?: string;
  activeTag?: string;
}

const {
  categories,
  tags,
  mode = 'live',
  idPrefix = 'sidebar',
  activeCategory,
  activeTag,
} = Astro.props;
const live = mode === 'live';

/** Tags render as grouped chips: 64 checkbox rows was the least usable part of the sidebar. */
const counts = new Map(tags.map((tag) => [tag.id, tag.count]));
const groups = TAG_GROUPS.map((group, index) => ({
  ...group,
  visible: index < TAG_GROUPS_VISIBLE,
  tags: group.tags.map((tag) => ({ id: tag, count: counts.get(tag) ?? 0 })),
})).filter((group) => group.tags.some((tag) => tag.count > 0));

const totalTags = groups.reduce((sum, group) => sum + group.tags.length, 0);
const hasHiddenGroups = groups.some((group) => !group.visible);

const rowBase =
  'group flex w-full items-center gap-2.5 rounded-chip px-2 py-1.5 text-left text-body text-ink-soft transition-colors';
const headingClass = 'mb-2 px-2 text-[11px] font-semibold uppercase tracking-[0.09em] text-ink-muted';
const groupClass = 'mb-3 px-2 text-[11px] font-medium uppercase tracking-[0.07em] text-ink-muted/80';
---

<div class="space-y-6" data-filter-panel>
  <section aria-labelledby={`${idPrefix}-categories`}>
    <h2 id={`${idPrefix}-categories`} class={headingClass}>Browse by category</h2>
    <ul class="space-y-0.5" data-category-list>
      {
        categories.map((category) => (
          <li>
            {live ? (
              <button
                type="button"
                data-filter-category={category.id}
                data-label={category.label}
                aria-pressed="false"
                class:list={[rowBase, 'hover:bg-mint-100 hover:text-accent']}
              >
                <span
                  data-marker
                  class="grid size-7 shrink-0 place-items-center rounded-[8px] bg-mint-100 text-accent transition-colors"
                >
                  <svg class="size-4" aria-hidden="true">
                    <use href={`#icon-${category.id}`} />
                  </svg>
                </span>
                <span>{category.label}</span>
                <span
                  class="ml-auto text-meta tabular-nums text-ink-muted"
                  data-count-category={category.id}
                >
                  {category.count}
                </span>
              </button>
            ) : (
              <a
                href={`/category/${category.id}`}
                aria-current={activeCategory === category.id ? 'page' : undefined}
                class:list={[
                  rowBase,
                  'hover:bg-mint-100',
                  activeCategory === category.id && 'bg-mint-100 font-medium text-accent',
                ]}
              >
                <span class="grid size-7 shrink-0 place-items-center rounded-[8px] bg-mint-100 text-accent">
                  <svg class="size-4" aria-hidden="true">
                    <use href={`#icon-${category.id}`} />
                  </svg>
                </span>
                <span>{category.label}</span>
                <span class="ml-auto text-meta tabular-nums text-ink-muted">{category.count}</span>
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby={`${idPrefix}-tags`}>
    <h2 id={`${idPrefix}-tags`} class={headingClass}>Filter by tag</h2>

    <div data-tag-groups>
      {
        groups.map((group) => (
          <div data-tag-group class:list={[!group.visible && 'tag-extra']}>
            <h3 class={groupClass}>{group.label}</h3>
            <ul class="flex flex-wrap gap-1.5 px-2" data-tag-list>
              {group.tags.map((tag) => (
                <li>
                  {live ? (
                    <button
                      type="button"
                      data-filter-tag={tag.id}
                      aria-pressed="false"
                      class="chip chip--filter"
                    >
                      <span>{tag.id}</span>
                      <span class="chip__count" data-count-tag={tag.id}>
                        {tag.count}
                      </span>
                    </button>
                  ) : (
                    <a
                      href={`/tag/${tagSlug(tag.id)}`}
                      aria-current={activeTag === tagSlug(tag.id) ? 'page' : undefined}
                      class="chip chip--filter"
                    >
                      <span>{tag.id}</span>
                      <span class="chip__count">{tag.count}</span>
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {
      hasHiddenGroups && (
        <button
          type="button"
          data-toggle-tags
          data-more={`All ${totalTags} tags`}
          data-less="Fewer tags"
          hidden
          class="mx-2 mt-1 inline-flex items-center gap-1 rounded-chip px-2 py-1 text-meta font-medium text-accent transition-colors hover:bg-mint-100"
          aria-expanded="false"
        >
          <svg
            viewBox="0 0 24 24"
            class="size-3.5 transition-transform"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m6 9.5 6 6 6-6" />
          </svg>
          <span data-toggle-tags-label>All {totalTags} tags</span>
        </button>
      )
    }
  </section>

  {
    live && (
      <button
        type="button"
        data-clear-filters
        hidden
        class="mx-2 inline-flex items-center gap-1.5 rounded-chip px-2 py-1 text-meta font-medium text-accent transition-colors hover:bg-mint-100"
      >
        <svg
          viewBox="0 0 24 24"
          class="size-3.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
        Clear filters
      </button>
    )
  }
</div>
