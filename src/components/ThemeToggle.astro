---
/**
 * Light/dark switch.
 *
 * The icon is driven by CSS, not JavaScript, so the right glyph is shown even
 * before the script runs and on pages where it fails. `aria-pressed` and the
 * label are kept in sync by src/scripts/theme.ts.
 */
interface Props {
  class?: string;
}

const { class: extra = '' } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  class:list={[
    'group relative grid size-9 shrink-0 place-items-center rounded-chip border border-line bg-surface text-ink-soft transition-colors hover:bg-mint-100 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700',
    extra,
  ]}
  aria-pressed="false"
  aria-label="Switch to dark theme"
  title="Switch to dark theme"
>
  <span class="theme-toggle__icons" aria-hidden="true">
    <!-- Sun: shown while the light theme is active. -->
    <svg class="theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2.8v2.1M12 19.1v2.1M4.5 4.5l1.5 1.5M18 18l1.5 1.5M2.8 12h2.1M19.1 12h2.1M4.5 19.5 6 18M18 6l1.5-1.5" />
    </svg>
    <!-- Moon: shown while the dark theme is active. -->
    <svg class="theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 14.4A8.2 8.2 0 0 1 9.6 4a8.4 8.4 0 1 0 10.4 10.4Z" />
    </svg>
  </span>
</button>
