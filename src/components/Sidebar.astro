---
import Brand from './Brand.astro';
import FilterPanel from './FilterPanel.astro';
import type { CountedOption } from '../lib/derive';

interface Props {
  categories: CountedOption[];
  tags: CountedOption[];
  total: number;
  recentCount: number;
  featuredCount: number;
  currentPath?: string;
  mode?: 'live' | 'links';
  activeCategory?: string;
  activeTag?: string;
}

const {
  categories,
  tags,
  total,
  recentCount,
  featuredCount,
  currentPath = '/',
  mode = 'links',
  activeCategory,
  activeTag,
} = Astro.props;

const navBase =
  'flex items-center gap-3 rounded-chip px-3 py-2 text-nav font-medium transition-colors';
---

<aside
  class="flex h-full flex-col gap-6 overflow-y-auto border-line bg-surface px-4 py-5 lg:border-r"
  aria-label="Browse the library"
>
  <div>
    <Brand />
    <p class="mt-2 px-1 text-meta leading-relaxed text-ink-muted">
      A hand-picked toolbox of the useful internet.
    </p>
  </div>

  <nav aria-label="Views" class="mt-1">
    <ul class="space-y-0.5">
      <li>
        <a
          href="/"
          data-nav-all
          class:list={[
            navBase,
            currentPath === '/'
              ? 'bg-mint-100 text-accent'
              : 'text-ink-soft hover:bg-mint-100/70 hover:text-accent',
          ]}
        >
          <svg viewBox="0 0 24 24" class="size-[18px]" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 10.6 12 4l8 6.6V19a1 1 0 0 1-1 1h-4v-5.4H9V20H5a1 1 0 0 1-1-1v-8.4Z" />
          </svg>
          <span>All resources</span>
          <span class="ml-auto text-meta font-normal tabular-nums text-ink-muted">{total}</span>
        </a>
      </li>
      <li>
        <a
          href="/new"
          class:list={[
            navBase,
            currentPath === '/new'
              ? 'bg-mint-100 text-accent'
              : 'text-ink-soft hover:bg-mint-100/70 hover:text-accent',
          ]}
        >
          <svg viewBox="0 0 24 24" class="size-[18px]" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m12 4.5 1.8 4.7 4.7 1.8-4.7 1.8L12 17.5l-1.8-4.7L5.5 11l4.7-1.8L12 4.5Z" />
            <path d="M17.8 16.2 18.6 18l1.8.8-1.8.8-.8 1.8-.8-1.8-1.8-.8 1.8-.8.8-1.8Z" />
          </svg>
          <span>New</span>
          <span class="ml-auto text-meta font-normal tabular-nums text-ink-muted">{recentCount}</span>
        </a>
      </li>
      <li>
        <a
          href="/featured"
          class:list={[
            navBase,
            currentPath === '/featured'
              ? 'bg-mint-100 text-accent'
              : 'text-ink-soft hover:bg-mint-100/70 hover:text-accent',
          ]}
        >
          <svg viewBox="0 0 24 24" class="size-[18px]" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true">
            <path d="m12 4.5 2.3 4.9 5.2.7-3.8 3.7.9 5.3-4.6-2.5-4.6 2.5.9-5.3L4.5 10l5.2-.7L12 4.5Z" />
          </svg>
          <span>Start here</span>
          <span class="ml-auto text-meta font-normal tabular-nums text-ink-muted">{featuredCount}</span>
        </a>
      </li>
    </ul>
  </nav>

  <FilterPanel
    categories={categories}
    tags={tags}
    mode={mode}
    idPrefix="sidebar"
    activeCategory={activeCategory}
    activeTag={activeTag}
  />

  <p class="mt-auto px-2 pt-4 text-meta leading-relaxed text-ink-muted">
    Click any card to open it. Hand-picked — nothing here is an ad.
  </p>
</aside>
